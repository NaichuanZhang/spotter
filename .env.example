# SPOTTER — copy to .env and fill in. .env is gitignored; .env.example is not.
#
# There is exactly ONE secret in this project. It lives in the server process
# (and in `insta secrets` when deployed) and never reaches the browser: the
# browser gets a short-lived ephemeral token from POST /api/session instead.

# ---------------------------------------------------------------------------
# Boson AI (Higgs) API key — required.
#
# !! CLAIM THE TRIAL CREDIT FIRST !!
# A new key is provisioned with ZERO usable balance. There is a banner on the
# Boson API Keys page that grants the trial credit, and until you click it
# EVERY call returns 429 insufficient_quota — realtime, TTS and avatar alike.
# The key itself is valid, which makes this look like a rate limit rather than
# an unclaimed balance. If you see 429 insufficient_quota, this is why.
# ---------------------------------------------------------------------------
BOSON_API_KEY=bai-your-key-here

# Port the Node server binds (0.0.0.0). Instacloud injects its own; 8080 locally.
PORT=8080

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# BOSONAI_API_KEY — accepted as a fallback everywhere BOSON_API_KEY is read,
#   because that is the name the Boson dashboard's shell snippet exports.
#   Prefer BOSON_API_KEY; this only exists so a key that is present under the
#   other name does not look like a missing key.
#
# DIST_DIR — override the static root. Defaults to ../dist relative to
#   server/index.mjs, which is correct locally and inside the container.

# ---------------------------------------------------------------------------
# What does NOT go here
# ---------------------------------------------------------------------------
# - No model ids, voices or thresholds: those are named constants in code
#   (scripts/bake-intros.mjs, src/pose/*), so they stay reviewable and tunable
#   in one place instead of drifting across environments.
# - No persona instructions or tool schemas: POST /v1/realtime/client_secrets
#   accepts only `expires_after` (additionalProperties: false), so the session
#   cannot be pre-configured server-side at all. They live in browser JS.
