node_modules/
dist/

# Secrets. Only .env.example is tracked.
.env
.env.local
.env.*.local

# Vendored MediaPipe model + wasm (~46 MB of binaries).
# Regenerate with: npm run vendor:mediapipe
public/vendor/

# Baked avatar intro videos ARE tracked, on purpose. They total ~2.8 MB, the
# Dockerfile does not run bake:intros (it would need the API key at build time,
# cost credits on every deploy, and add ~75 s), and without them the deployed
# intro screen renders three empty video elements. Regenerate with:
#   npm run bake:intros            # all three, but see below
#   node scripts/bake-intros.mjs --only=mean
# Render them ONE AT A TIME: concurrent /v1/videos calls return HTTP 429
# rate_limit_exceeded on this account.

# Instacloud CLI state.
.insta/

# Agent skills installed by `insta project create` (vendored third-party docs for
# Tigris / better-auth / insta — ~130 files, none of them this project's code).
# Regenerated by the CLI; the insta CLI itself adds these ignores, but our
# .gitignore is authored so they have to be restated here.
.claude/skills/
.agents/skills/
.github/skills/
skills-lock.json

# Build / test / editor noise.
*.log
build.log
*.tsbuildinfo
coverage/
.vitest/
.DS_Store
.vscode/
.idea/

# Screenshots taken while eyeballing the UI (Playwright, 1440x900 PNGs, ~600 kB each).
# Scratch output, regenerable by re-running the browser, and they were sitting in
# `git add -A`'s path at ~6 MB. Not the rendered reference clips — those are
# public/clips/ and ARE tracked, see below.
shots/

# Reference clips ARE committed on purpose. They are not filmed footage — they are
# skeleton animations rendered by scripts/render-refs.mjs from pose landmarks that
# were extracted from a reference video with the app's own vendored MediaPipe model
# (see public/clips/landmarks.json). Only the derived motion data and our own
# drawing ship; no frame of the source video is in this repo.


# Local agent credentials
.insta/agent-session.json

.insta/.agent-session-*.tmp
