node_modules/
dist/

# Secrets. Only .env.example is tracked.
.env
.env.local
.env.*.local

# Vendored MediaPipe model + wasm (~46 MB of binaries).
# Regenerate with: npm run vendor:mediapipe
public/vendor/

# Baked avatar intro videos. Regenerate with: npm run bake:intros
public/avatars/*.mp4

# Instacloud CLI state.
.insta/

# Agent skills installed by `insta project create` (vendored third-party docs for
# Tigris / better-auth / insta — ~130 files, none of them this project's code).
# Regenerated by the CLI; the insta CLI itself adds these ignores, but our
# .gitignore is authored so they have to be restated here.
.claude/skills/
.agents/skills/
.github/skills/
skills-lock.json

# Build / test / editor noise.
*.log
build.log
*.tsbuildinfo
coverage/
.vitest/
.DS_Store
.vscode/
.idea/

# Reference clips are shot on a phone and committed on purpose — public/clips/
# stays tracked (manifest.json especially).
